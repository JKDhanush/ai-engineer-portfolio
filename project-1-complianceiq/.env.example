# Copy to .env:   cp .env.example .env
# .env holds secrets and is git-ignored. This example file is committed so others know what to set.

# --- Postgres (used by docker compose to create the DB) ---
POSTGRES_USER=complianceiq
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=complianceiq

# --- App ---
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- Only for running Python on your laptop (venv), e.g. ingestion scripts ---
# Inside Docker these are overridden in docker-compose.yml to use service names.
DATABASE_URL=postgresql://complianceiq:change-me-locally@localhost:5432/complianceiq
REDIS_URL=redis://localhost:6379/0

# --- Retrieval (defaults come from the ablation in evals/results/retrieval_report.md) ---
# RETRIEVAL_MODE=vector_rerank
# below this top score the API refuses instead of answering
# MIN_RERANK_SCORE=0.31
# none | multi_query | hyde
# QUERY_EXPANSION=none

# --- LLM providers, tried in order; the next one is used if one fails ---
# e.g. ollama,openai_compat   or   bedrock
LLM_PROVIDERS=ollama
LLM_MODEL=phi4-mini
# OpenAI-compatible hosted API (Groq has a free tier). Put the real key ONLY in .env, never in code or chat.
# OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_COMPAT_MODEL=llama-3.1-8b-instant
# OPENAI_COMPAT_API_KEY=
# AWS Bedrock (Phase D): uses the AWS credentials of the machine / IAM role, no key here
# BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
# AWS_REGION=ap-south-1
# Judge for `make eval-gen` (a stronger model than the one answering, if you have one):
# JUDGE_PROVIDERS=openai_compat

# --- Platform ---
# true = login needed (create users with `make user`)
AUTH_REQUIRED=false
# Generate a long random secret:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me
RATE_LIMIT_PER_MINUTE=20
# CACHE_TTL_S=86400
# SEMANTIC_CACHE_THRESHOLD=0.95

# --- Later (Phase D) ---
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
