# Caddy gets and renews a free Let's Encrypt HTTPS certificate for SITE_ADDRESS automatically.
# sslip.io turns an IP into a hostname (13-233-10-20.sslip.io -> 13.233.10.20), so no domain purchase is needed.
{$SITE_ADDRESS} {
	# API: strip the /api prefix; flush immediately so streamed answers (SSE) arrive word by word
	handle_path /api/* {
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}
	handle {
		encode gzip
		reverse_proxy web:3000
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}
